server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Fallback para o roteamento do React (SPA)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache longo para arquivos com hash gerados pelo Vite
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}